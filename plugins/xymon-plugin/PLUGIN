# What this plugin is, for the index in README.md and for whoever installs
# it alone. One key per line, a key repeated for each line of a message;
# ./xymon-plugin at the repository's top -- a link to this directory's
# xymon-plugin -- installs it from the lines below, as any other.
name: xymon-plugin
version: 0.2.8
summary: the installer of these plugins, installed beside them as one of them, so that what is installed and its version are known on the server
manual: xymon-plugin.8

# How ./xymon-plugin installs it: see xymonapi's PLUGIN file. It is the
# installer itself: its version is the one --version gives.
server-short: the installer, kept on the server, and the plugins column
server-files: xymon-plugin xymon-plugin-report.sh
server-manual: xymon-plugin.8
server-task: xymon-plugin.tasks.DIST
executable: xymon-plugin xymon-plugin-report.sh
# On a monitored host's Xymon client, the installer, beside the plugins it
# installs there, and the plugins column of that host.
client-short: the installer, kept in the client's tree beside its plugins, and the plugins column
client-files: xymon-plugin xymon-plugin-report.sh
client-manual: xymon-plugin.8
client-task: xymon-plugin-client.tasks.DIST
