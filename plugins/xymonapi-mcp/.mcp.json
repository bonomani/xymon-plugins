{
  "mcpServers": {
    "xymon": {
      "command": "${CLAUDE_PLUGIN_ROOT}/xymonapi-mcp.sh",
      "env": {
        "XYMONAPI_URL": "${XYMONAPI_URL:-http://127.0.0.1:1986}",
        "XYMONAPI_TOKEN_FILE": "${XYMONAPI_TOKEN_FILE:-}",
        "XYMONAPI_CA": "${XYMONAPI_CA:-}",
        "XYMONAPI_PYTHON": "${XYMONAPI_PYTHON:-python3}"
      }
    }
  }
}
